{
  "name": "loanagent-lab",
  "version": "0.1.0",
  "description": "Local-first synthetic loan application agent lab for deterministic decision traces and reviewer handoffs.",
  "type": "module",
  "bin": { "loanagent-lab": "./bin/loanagent-lab.js" },
  "main": "./src/index.js",
  "exports": { ".": "./src/index.js" },
  "files": ["bin", "src", "fixtures", "docs", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.js",
    "build": "node scripts/build.js",
    "smoke": "node scripts/smoke.js",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": ["loan", "agent", "compliance", "synthetic-data", "local-first", "cli"],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/loanagent-lab.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/loanagent-lab/issues"
  },
  "homepage": "https://github.com/rogerchappel/loanagent-lab#readme",
  "engines": { "node": ">=20" }
}
